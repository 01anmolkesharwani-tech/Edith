# CareerReach configuration. Copy to .env and adjust. Never commit .env.

# SQLite database file (relative to the project root).
DATABASE_URL="file:./data/careerreach.db"

# Optional: where résumés and backups are stored (default ./data).
# CAREERREACH_DATA_DIR="./data"

# Optional: require a password to open the app (recommended if it is reachable from other devices).
# CAREERREACH_ACCESS_PASSWORD="choose-a-long-passphrase"

# Sender app passwords. Each profile's sender account names ONE of these variables.
# Gmail: create an app password at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# CAREERREACH_SMTP_PASS_MARKETING=""
# CAREERREACH_SMTP_PASS_FINANCE=""

# Optional integrations (not required by any core workflow).
# Brave Search API (requires an account and a payment method on file; free monthly credit is limited).
# BRAVE_SEARCH_API_KEY=""
# Hunter.io email verifier (free plan: small monthly credit allowance).
# HUNTER_API_KEY=""
